# ==============================================================================
# MEDISPHERE PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and populate with your real project credentials.
# NEVER commit .env.local or production secrets to Git.

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (Required)
# ------------------------------------------------------------------------------
# Project URL from Supabase Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Publishable Key (Client-Safe)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Supabase Service Role Key (SERVER-ONLY / CLI ONLY - NEVER prefix with NEXT_PUBLIC_)
# Used solely for server-side maintenance scripts (such as scripts/promote-admin.ts).
# Do not expose in client-side code or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Resend Email Service Configuration (Server-Only, Optional for Local Dev)
# ------------------------------------------------------------------------------
# API key from resend.com for sending transactional confirmation emails
RESEND_API_KEY=re_123456789...

# Sender address (must use a verified domain in Resend for production delivery,
# e.g., "MediSphere Appointments <appointments@medisphere.in>" or "onboarding@resend.dev" for testing)
RESEND_FROM_EMAIL=MediSphere <appointments@medisphere.in>

# ------------------------------------------------------------------------------
# 3. Application Base URL (Server-Only, Optional)
# ------------------------------------------------------------------------------
# Used in transactional email links (defaults to http://localhost:3000 if omitted)
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Google Maps API Configuration (Client-Safe, Optional)
# ------------------------------------------------------------------------------
# Restricted browser API key for interactive clinic maps and directions
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
